{
  "id": "./",
  "name": "BeBeam",
  "short_name": "BeBeam",
  "description": "내가 만든 웹앱을 폰에 담고, 친구와 폰을 맞대어 나누는 플레이어",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f6f8",
  "theme_color": "#ffffff",
  "protocol_handlers": [{ "protocol": "web+bebeam", "url": "./?launch=%s" }],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
